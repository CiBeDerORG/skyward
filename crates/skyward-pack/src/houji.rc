# qseecomd opens its backing files at the vendor fstab path.
on post-fs
    mkdir /mnt/vendor 0755 root root
    mkdir /mnt/vendor/persist 0755 root root
    wait /dev/block/by-name/persist 5
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist ro nosuid nodev noatime noload

# Stock recovery defines this early_hal service but only starts class hal.
on early-boot
    start vendor.boot-qti
